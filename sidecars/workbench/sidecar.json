{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Split Workbench",
  "description": "Smart auto-splitting side pane workbench for viewing files, localhost web previews, real PTY terminals, and session artifacts side-by-side or stacked.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": true
  },
  "ui_config": {
    "display_name": "Split Workbench",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Split"
      }
    ]
  }
}
